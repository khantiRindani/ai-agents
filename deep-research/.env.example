# ── LLM Configuration ──────────────────────────────────────────────
# Controls which LLM provider is used. Cartographer is model-agnostic.
# Options: "google", "anthropic", "openai"
CARTOGRAPHER_LLM_PROVIDER=google

# Model name within the chosen provider
# google  → "gemini-2.0-flash", "gemini-1.5-pro"
# anthropic → "claude-3-haiku-20240307", "claude-3-5-sonnet-20241022"
# openai  → "gpt-4o-mini", "gpt-4o"
# ollama → "gemma4", "qwen3"
CARTOGRAPHER_LLM_MODEL=gemini-3.6-flash

# Provider API keys (only the one you use is required)
GOOGLE_API_KEY=your_google_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# OLLAMA_API_URL=your_ollama_local_serving_path

# ── Search Configuration ────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# Max search results per waypoint (Tavily)
TAVILY_MAX_RESULTS=5

# ── Agent Behaviour ─────────────────────────────────────────────────
# Max re-expedition loops when critic score is below threshold
MAX_EXPEDITIONS=2

# Critic coverage score threshold (0–10); below this triggers re-search
CRITIC_SCORE_THRESHOLD=7.0

# ── Optional: LangSmith Tracing ─────────────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=cartographer

# Other configs
CARTOGRAPHER_LOG_LEVEL=DEBUG